<Window x:Class="ManifestLE.App.Views.MfaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ManifestLE — Authenticator Verification"
        Width="520"
        Height="730"
        MinWidth="440"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">
            <TextBlock Text="ManifestLE"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="InstructionsText"
                       Foreground="#D8DDE4"
                       Margin="0,14,0,22"/>

            <StackPanel x:Name="EnrollmentPanel"
                        Visibility="Collapsed">
                <Border Background="White"
                        Padding="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <Image x:Name="QrImage"
                           Width="240"
                           Height="240"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <TextBlock Text="Can't scan? Enter this setup key in your authenticator:"
                           Foreground="#9CA7B5"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="ManualKeyBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         Margin="0,0,0,22"/>
            </StackPanel>

            <TextBlock Text="Six-digit authenticator code"/>

            <TextBox x:Name="CodeBox"
                     MaxLength="6"
                     FontSize="24"
                     HorizontalContentAlignment="Center"
                     Margin="0,8,0,18"
                     IsEnabled="False"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF9B9B"
                       Visibility="Collapsed"
                       Margin="0,0,0,18"/>

            <Button x:Name="VerifyButton"
                    Content="Verify"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="VerifyButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>