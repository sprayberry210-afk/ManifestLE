<UserControl x:Class="ManifestLE.App.Views.ChainOfCustodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#15181D"
             Foreground="#F4F6F8"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#171A1F"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#263B50"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1479D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#171A1F"
                                                BorderBrush="#64748B"
                                                BorderThickness="1">
                                            <TextBlock Text="▼"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBlock
                                Text="{Binding SelectedItem.Name,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="10,0,35,0"
                                VerticalAlignment="Center"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#171A1F"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        MaxHeight="280"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Chain of Custody"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Review history, transfer storage, check out, or check in an item."
                       Foreground="#9CA7B5"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="#20242A"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <StackPanel x:Name="SelectionPanel">
                            <TextBlock Text="Register"/>
                            <ComboBox x:Name="RegisterBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="RegisterBox_SelectionChanged"/>

                            <TextBlock Text="Item"/>
                            <ComboBox x:Name="ItemBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ItemBox_SelectionChanged"/>
                        </StackPanel>

                        <TextBlock x:Name="CurrentLocationText"
                                   Foreground="#D8DDE4"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="CurrentCustodianText"
                                   Foreground="#9CA7B5"
                                   Margin="0,0,0,18"/>

                        <StackPanel x:Name="MovementPanel"
                                    IsEnabled="False">
                            <TextBlock Text="Action *"/>
                            <ComboBox x:Name="ActionBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ActionBox_SelectionChanged"/>

                            <StackPanel x:Name="DestinationPanel">
                                <TextBlock Text="Destination storage location *"/>
                                <ComboBox x:Name="DestinationBox"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>

                            <TextBlock x:Name="FromLabel"
                                       Text="Handed over by *"/>
                            <TextBox x:Name="FromCustodianBox"
                                     MaxLength="200"/>

                            <TextBlock x:Name="ToLabel"
                                       Text="Received by *"/>
                            <TextBox x:Name="ToCustodianBox"
                                     MaxLength="200"/>

                            <TextBlock Text="Reason *"/>
                            <TextBox x:Name="ReasonBox"
                                     MaxLength="1000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="65"/>

                            <TextBlock Text="Notes"/>
                            <TextBox x:Name="NotesBox"
                                     MaxLength="4000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="65"/>

                            <TextBlock x:Name="ActionHelpText"
                                       Foreground="#9CA7B5"
                                       Margin="0,0,0,14"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,14"/>

                        <Button x:Name="SaveButton"
                                Content="Record Movement"
                                HorizontalAlignment="Right"
                                IsEnabled="False"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Custody History"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,24,0,12"/>

                <TextBox x:Name="HistoryBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="220"
                         Text="Select an item to view its custody history."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>