<UserControl x:Class="ManifestLE.App.Views.InventoryAuditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#15181D"
             Foreground="#F4F6F8"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#20242A"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#263B50"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1479D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#171A1F"
                                                BorderBrush="#64748B"
                                                BorderThickness="1">
                                            <TextBlock Text="▾"
                                                       Foreground="#F4F6F8"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,8,32,8"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#20242A"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellBorder"
                                        Property="Background"
                                        Value="#263B50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ScreenPanel" Margin="0,0,12,16">
            <TextBlock Text="Inventory Audits"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Verify stored property against a checklist captured when the audit starts."
                       Foreground="#9CA7B5"
                       Margin="0,8,0,18"/>

            <Border Background="#20242A"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Start an Audit"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Storage location" Margin="0,0,0,6"/>

                    <ComboBox x:Name="LocationBox"
                              DisplayMemberPath="Label"/>

                    <CheckBox x:Name="IncludeChildrenBox"
                              Content="Include cabinets, shelves, and other child locations"
                              Foreground="#F4F6F8"
                              IsChecked="True"
                              Margin="0,12,0,12"/>

                    <TextBlock Text="Starting notes" Margin="0,0,0,6"/>

                    <TextBox x:Name="StartNotesBox"
                             MaxLength="4000"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="60"
                             MaxHeight="100"
                             VerticalScrollBarVisibility="Auto"/>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Start audit"
                                Click="StartButton_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Refresh"
                                Background="#334155"
                                Click="RefreshButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="#20242A"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Resume or Review"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ComboBox x:Name="AuditBox"
                              DisplayMemberPath="Label"
                              SelectionChanged="AuditBox_SelectionChanged"/>

                    <TextBlock x:Name="AuditSummaryText"
                               Foreground="#9CA7B5"
                               Margin="0,12,0,8"
                               Text="Select an audit."/>

                    <TextBlock x:Name="StartingNotesText"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="ItemsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              MinRowHeight="48"
                              MaxHeight="300"
                              VerticalAlignment="Top"
                              Background="#20242A"
                              RowBackground="#20242A"
                              AlternatingRowBackground="#171A1F"
                              BorderBrush="#2D333B"
                              GridLinesVisibility="None"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionChanged="ItemsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Register"
                                                Binding="{Binding Register}"
                                                Width="130"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Case / Report"
                                                Binding="{Binding ReportNumber}"
                                                Width="125"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Item"
                                                Binding="{Binding ItemNumber}"
                                                Width="65"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"
                                                MinWidth="160"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Expected Storage"
                                                Binding="{Binding Storage}"
                                                Width="*"
                                                MinWidth="180"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding Result}"
                                                Width="110"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="SelectedItemText"
                               Margin="0,14,0,8"
                               Text="Select an item to record its inspection."/>

                    <StackPanel x:Name="ItemEditor" IsEnabled="False">
                        <TextBlock Text="Inspection result" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ResultBox"/>

                        <TextBlock Text="Inspection notes — required for missing items or discrepancies"
                                   Margin="0,12,0,6"/>

                        <TextBox x:Name="ItemNotesBox"
                                 MaxLength="4000"
                                 MinHeight="75"
                                 MaxHeight="140"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button Content="Save item check"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="SaveItemButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="CheckInfoText"
                               Foreground="#9CA7B5"
                               Margin="0,10,0,0"/>

                    <Separator Background="#334155" Margin="0,18"/>

                    <StackPanel x:Name="CompletionPanel" IsEnabled="False">
                        <TextBlock Text="Completion notes" Margin="0,0,0,6"/>

                        <TextBox x:Name="CompletionNotesBox"
                                 MaxLength="4000"
                                 MinHeight="60"
                                 MaxHeight="120"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Completion locks the audit. Every item must have a saved inspection result."
                                   Foreground="#9CA7B5"
                                   Margin="0,8,0,10"/>

                        <Button Content="Complete and lock audit"
                                HorizontalAlignment="Left"
                                Click="CompleteButton_Click"/>
                    </StackPanel>

                    <TextBox x:Name="CompletionDetailsBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="160"
                             Margin="0,12,0,0"
                             Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Foreground="#9CA7B5"
                       Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>