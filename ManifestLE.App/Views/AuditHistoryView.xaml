<UserControl x:Class="ManifestLE.App.Views.AuditHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#15181D"
             Foreground="#F4F6F8"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Margin" Value="0,0,18,8"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#2D333B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263B50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Audit History"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Review application activity or follow an inventory audit from start to completion."
                       Foreground="#9CA7B5"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#20242A"
                Padding="16"
                CornerRadius="8"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Search case/report, item, user, action, record type, ID, or details"
                           Foreground="#9CA7B5"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="SearchBox"
                         MaxLength="200"
                         TextChanged="SearchBox_TextChanged"/>

                <WrapPanel Margin="0,12,0,0">
                    <RadioButton x:Name="AllButton"
                                 Content="All activity"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="AuthenticationButton"
                                 Content="Authentication"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="IntakeButton"
                                 Content="Intake"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="CustodyButton"
                                 Content="Custody"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="InventoryButton"
                                 Content="Inventory audits"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="SetupButton"
                                 Content="Setup / storage"
                                 GroupName="AuditCategory"
                                 Checked="Filter_Changed"/>
                </WrapPanel>

                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Margin="0,0,10,6"
                            Click="RefreshButton_Click"/>

                    <Button x:Name="ClearFiltersButton"
                            Content="Clear filters"
                            Background="#334155"
                            Margin="0,0,10,6"
                            Click="ClearFiltersButton_Click"/>

                    <Button x:Name="TimelineButton"
                            Content="Selected audit timeline"
                            Background="#334155"
                            IsEnabled="False"
                            Margin="0,0,16,6"
                            Click="TimelineButton_Click"/>

                    <CheckBox x:Name="OldestFirstBox"
                              Content="Oldest first"
                              Foreground="#F4F6F8"
                              VerticalAlignment="Center"
                              Margin="0,0,0,6"
                              Checked="Filter_Changed"
                              Unchecked="Filter_Changed"/>
                </WrapPanel>

                <TextBlock x:Name="TimelineText"
                           Foreground="#9CA7B5"
                           Visibility="Collapsed"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TableHeightLimit"
                    Grid.Row="0"
                    Visibility="Hidden"
                    IsHitTestVisible="False"/>

            <Grid Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="AuditGrid"
                          Grid.Row="0"
                          VerticalAlignment="Top"
                          MaxHeight="{Binding ActualHeight, ElementName=TableHeightLimit}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          MinRowHeight="48"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Background="#20242A"
                          RowBackground="#20242A"
                          AlternatingRowBackground="#171A1F"
                          Foreground="#F4F6F8"
                          BorderBrush="#2D333B"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="AuditGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recorded"
                                            Binding="{Binding RecordedLocal}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Case / Report"
                                            Binding="{Binding CaseNumber}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Item"
                                            Binding="{Binding ItemNumber}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="65"/>

                        <DataGridTextColumn Header="User"
                                            Binding="{Binding UserName}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="*"
                                            MinWidth="130"/>

                        <DataGridTextColumn Header="Action"
                                            Binding="{Binding Action}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="2*"
                                            MinWidth="200"/>

                        <DataGridTextColumn Header="Record Type"
                                            Binding="{Binding RecordType}"
                                            ElementStyle="{StaticResource AuditCellText}"
                                            Width="*"
                                            MinWidth="155"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Activity Details"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="DetailsBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="Select an audit entry to view its details."/>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="#9CA7B5"
                   Margin="0,14,0,0"/>
    </Grid>
</UserControl>