<Window x:Class="ManifestLE.App.Views.AgencySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ManifestLE — Agency Setup"
        Width="580"
        Height="650"
        MinWidth="480"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush" Value="White"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Set up your agency"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Enter the agency information for this installation."
                       Foreground="#9CA7B5"
                       Margin="0,10,0,26"/>

            <StackPanel x:Name="FormPanel">
                <TextBlock Text="Agency name *"/>
                <TextBox x:Name="AgencyNameBox"
                         MaxLength="200"/>

                <TextBlock Text="Agency code *"/>
                <TextBox x:Name="AgencyCodeBox"
                         MaxLength="50"/>

                <TextBlock Text="Address"/>
                <TextBox x:Name="AddressBox"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70"/>

                <TextBlock Text="Phone number"/>
                <TextBox x:Name="PhoneBox"
                         MaxLength="50"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF9B9B"
                       Margin="0,0,0,14"
                       Visibility="Collapsed"/>

            <Button x:Name="SaveButton"
                    Content="Save Agency"
                    HorizontalAlignment="Right"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>