<UserControl x:Class="ManifestLE.App.Views.PropertyRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#15181D"
             Foreground="#F4F6F8"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#2D333B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263B50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegisterCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="HeadingText"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Search records and select an item to view its details."
                       Foreground="#9CA7B5"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#20242A"
                Padding="16"
                CornerRadius="8"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Search report, item, description, owner, serial number, or storage"
                               Foreground="#9CA7B5"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SearchBox"
                             MaxLength="200"
                             TextChanged="SearchBox_TextChanged"/>

                    <WrapPanel Margin="0,12,0,0">
                        <RadioButton x:Name="AllStatusButton"
                                     Content="All"
                                     GroupName="RegisterStatus"
                                     Foreground="#F4F6F8"
                                     Margin="0,0,18,6"
                                     Checked="StatusFilter_Changed"/>

                        <RadioButton x:Name="InCustodyButton"
                                     Content="In custody"
                                     GroupName="RegisterStatus"
                                     Foreground="#F4F6F8"
                                     Margin="0,0,18,6"
                                     Checked="StatusFilter_Changed"/>

                        <RadioButton x:Name="CheckedOutButton"
                                     Content="Checked out"
                                     GroupName="RegisterStatus"
                                     Foreground="#F4F6F8"
                                     Margin="0,0,18,6"
                                     Checked="StatusFilter_Changed"/>

                        <RadioButton x:Name="ReleasedButton"
                                     Content="Released"
                                     GroupName="RegisterStatus"
                                     Foreground="#F4F6F8"
                                     Margin="0,0,18,6"
                                     Checked="StatusFilter_Changed"/>

                        <RadioButton x:Name="DisposedButton"
                                     Content="Disposed"
                                     GroupName="RegisterStatus"
                                     Foreground="#F4F6F8"
                                     Margin="0,0,0,6"
                                     Checked="StatusFilter_Changed"/>
                    </WrapPanel>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        VerticalAlignment="Top"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Measures a responsive ceiling for the table.
                 Hidden elements still participate in layout. -->
            <Border x:Name="TableHeightLimit"
                    Grid.Row="0"
                    Visibility="Hidden"
                    IsHitTestVisible="False"/>

            <Grid Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="RecordsGrid"
                          Grid.Row="0"
                          VerticalAlignment="Top"
                          MaxHeight="{Binding ActualHeight, ElementName=TableHeightLimit}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          MinRowHeight="48"
                          EnableRowVirtualization="True"
                          Background="#20242A"
                          RowBackground="#20242A"
                          AlternatingRowBackground="#171A1F"
                          Foreground="#F4F6F8"
                          BorderBrush="#2D333B"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="RecordsGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Case / Report"
                                            Binding="{Binding ReportNumber}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="125"
                                            MinWidth="110"/>

                        <DataGridTextColumn Header="Item"
                                            Binding="{Binding ItemNumber}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="65"
                                            MinWidth="60"/>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="2*"
                                            MinWidth="180"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusText}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="105"
                                            MinWidth="100"/>

                        <DataGridTextColumn Header="Storage"
                                            Binding="{Binding StoragePath}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="2*"
                                            MinWidth="220"/>

                        <DataGridTextColumn Header="Collected"
                                            Binding="{Binding CollectedLocal}"
                                            ElementStyle="{StaticResource RegisterCellText}"
                                            Width="145"
                                            MinWidth="135"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Item Details"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="DetailsBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="Select an item to view its details."/>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="#9CA7B5"
                   Margin="0,14,0,0"/>
    </Grid>
</UserControl>