<Window x:Class="ManifestLE.App.Views.IntakeCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct Intake Submission"
        Width="760"
        Height="740"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#171A1F"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background" Value="#263B50"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background" Value="#1479D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#171A1F"
                                                BorderBrush="#64748B"
                                                BorderThickness="1">
                                            <TextBlock Text="▼"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBlock Text="{Binding SelectedItem,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="10,0,35,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#171A1F"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        MaxHeight="280"
                                        MinWidth="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#1168B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush" Value="#75B9F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Correct Intake Submission"
                       FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubmissionText"
                       Foreground="#9CA7B5"
                       Margin="0,8,0,0"
                       Text="Loading submission…"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="#20242A"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Correction Instructions"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="InstructionsBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="75"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="FormPanel" IsEnabled="False">
                    <TextBlock Text="Description *"/>
                    <TextBox x:Name="DescriptionBox"
                             MaxLength="2000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"/>

                    <TextBlock Text="Packaging *"/>
                    <ComboBox x:Name="PackagingBox"/>

                    <TextBlock Text="Intake notes"/>
                    <TextBox x:Name="NotesBox"
                             MaxLength="4000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="110"/>
                </StackPanel>

                <TextBlock
                    Text="Resubmission updates the intake documentation. It does not record a physical custody movement."
                    Foreground="#9CA7B5"
                    Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   Margin="0,12,0,12"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Margin="0,0,12,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="ResubmitButton"
                    Content="Resubmit for Review"
                    IsEnabled="False"
                    Click="ResubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>