<Window x:Class="ManifestLE.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ManifestLE — Development"
        Width="1200"
        Height="780"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#15181D"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DDE4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#263B50"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush" Value="#75B9F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA7B5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="15,18,0,9"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#171A1F"
                BorderBrush="#2D333B"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="12,16,0,22">
                    <TextBlock Text="ManifestLE"
                               Foreground="#F4F6F8"
                               FontSize="27"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Evidence &amp; Property"
                               Foreground="#9CA7B5"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="DashboardButton"
                                Content="Dashboard"
                                Style="{StaticResource NavigationButton}"
                                Click="DashboardButton_Click"/>

                        <TextBlock Text="INTAKE"
                                   Style="{StaticResource NavigationSection}"/>

                        <Button x:Name="IntakeButton"
                                Content="Item Intake"
                                Style="{StaticResource NavigationButton}"
                                Click="IntakeButton_Click"/>

                        <TextBlock Text="REGISTERS"
                                   Style="{StaticResource NavigationSection}"/>

                        <Button x:Name="EvidenceRecordsButton"
                                Content="Evidence Records"
                                Style="{StaticResource NavigationButton}"
                                Click="EvidenceRecordsButton_Click"/>

                        <Button x:Name="FoundPropertyButton"
                                Content="Found Property"
                                Style="{StaticResource NavigationButton}"
                                Click="FoundPropertyButton_Click"/>

                        <Button x:Name="SafekeepingButton"
                                Content="Safekeeping"
                                Style="{StaticResource NavigationButton}"
                                Click="SafekeepingButton_Click"/>

                        <TextBlock Text="PROPERTY CONTROL"
                                   Style="{StaticResource NavigationSection}"/>

                        <Button x:Name="ChainOfCustodyButton"
                                Content="Chain of Custody"
                                Style="{StaticResource NavigationButton}"
                                Click="ChainOfCustodyButton_Click"/>

                        <Button x:Name="StorageLocationsButton"
                                Content="Storage Locations"
                                Style="{StaticResource NavigationButton}"
                                Click="StorageLocationsButton_Click"/>

                        <Button x:Name="InventoryAuditsButton"
                                Content="Inventory Audits"
                                Style="{StaticResource NavigationButton}"
                                IsEnabled="False"
                                Click="InventoryAuditsButton_Click"/>

                        <TextBlock Text="SYSTEM">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource NavigationSection}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled,
                                                     ElementName=AuditHistoryButton}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled,
                                                     ElementName=UserAdministrationButton}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="AuditHistoryButton"
                                Content="Audit History"
                                Style="{StaticResource NavigationButton}"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Click="AuditHistoryButton_Click"/>

                        <Button x:Name="UserAdministrationButton"
                                Content="User Administration"
                                Style="{StaticResource NavigationButton}"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Click="UserAdministrationButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="#2D333B"
                        BorderThickness="0,1,0,0"
                        Padding="12,16,12,8"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SignedInNameText"
                                   Foreground="#D8DDE4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Development"
                                   Foreground="#9CA7B5"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="WorkspaceContent">
                <Grid x:Name="DashboardPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Dashboard"
                                   Foreground="#F4F6F8"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Evidence and property overview"
                                   Foreground="#9CA7B5"
                                   FontSize="14"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#20242A"
                            BorderBrush="#2D333B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="28">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock Text="Welcome to ManifestLE"
                                       Foreground="#F4F6F8"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DashboardWelcomeText"
                                       Foreground="#D8DDE4"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>

            <TextBlock Grid.Row="1"
                       Text="ManifestLE • Development workspace"
                       Foreground="#9CA7B5"
                       FontSize="12"
                       Margin="0,18,0,0"/>
        </Grid>
    </Grid>
</Window>