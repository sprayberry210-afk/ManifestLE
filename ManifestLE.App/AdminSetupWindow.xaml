<Window x:Class="ManifestLE.App.Views.AdminSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ManifestLE — Administrator Setup"
        Width="580"
        Height="680"
        MinWidth="480"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#171A1F"/>
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="CaretBrush" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1479D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1168B5"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">
            <TextBlock Text="Create your administrator"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Create the first account for this installation."
                       Foreground="#9CA7B5"
                       Margin="0,10,0,26"/>

            <StackPanel x:Name="FormPanel">
                <TextBlock Text="Display name"/>
                <TextBox x:Name="DisplayNameBox"
                         MaxLength="150"/>

                <TextBlock Text="Username"/>
                <TextBox x:Name="UsernameBox"
                         MaxLength="50"/>

                <TextBlock Text="Use letters, numbers, periods, underscores, or hyphens."
                           Foreground="#9CA7B5"
                           FontSize="12"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Password"/>
                <PasswordBox x:Name="PasswordInput"
                             MaxLength="128"/>

                <TextBlock Text="Use 15–128 characters. Spaces are allowed."
                           Foreground="#9CA7B5"
                           FontSize="12"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Confirm password"/>
                <PasswordBox x:Name="ConfirmPasswordInput"
                             MaxLength="128"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF9B9B"
                       Margin="0,0,0,14"
                       Visibility="Collapsed"/>

            <Button x:Name="CreateButton"
                    Content="Create Administrator"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>